  "fixed_sql": [
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"user_id\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"version\" INTEGER NOT NULL DEFAULT 0, \"server_updated_at\" TEXT NULL, \"deleted_at\" TEXT NULL, \"sync_status\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"icon\" TEXT NOT NULL, \"color\" TEXT NULL, \"is_default\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_default\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"user_id\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"version\" INTEGER NOT NULL DEFAULT 0, \"server_updated_at\" TEXT NULL, \"deleted_at\" TEXT NULL, \"sync_status\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL CHECK(\"amount\" > 0 AND \"amount\" <= 999999999999), \"currency\" TEXT NOT NULL DEFAULT 'XOF', \"category_id\" TEXT NOT NULL REFERENCES categories (id), \"note\" TEXT NULL, \"note_search\" TEXT NULL, \"occurred_on\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "budgets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budgets\" (\"id\" TEXT NOT NULL, \"user_id\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"version\" INTEGER NOT NULL DEFAULT 0, \"server_updated_at\" TEXT NULL, \"deleted_at\" TEXT NULL, \"sync_status\" TEXT NOT NULL, \"period\" TEXT NOT NULL, \"category_id\" TEXT NULL REFERENCES categories (id), \"limit_amount\" INTEGER NOT NULL CHECK(\"limit_amount\" >= 0), \"currency\" TEXT NOT NULL DEFAULT 'XOF', \"alert_thresholds\" TEXT NOT NULL DEFAULT '[80,100]', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox\" (\"seq\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"op_id\" TEXT NOT NULL UNIQUE, \"entity\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"op_type\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, \"changed_fields\" TEXT NOT NULL DEFAULT '[]', \"base_version\" INTEGER NOT NULL, \"user_id\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'pending', \"attempts\" INTEGER NOT NULL DEFAULT 0, \"next_attempt_at\" TEXT NULL, \"last_error\" TEXT NULL, \"created_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "sync_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_state\" (\"user_id\" TEXT NOT NULL, \"cursor\" TEXT NULL, \"last_success_at\" TEXT NULL, \"last_attempt_at\" TEXT NULL, \"last_error\" TEXT NULL, PRIMARY KEY (\"user_id\"));"
        }
      ]
    },
