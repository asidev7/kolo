<?xml version="1.0" encoding="utf-8"?>
<!-- §8 : aucune sauvegarde cloud ni transfert d'appareil des données de
     l'application (Android 12+). Les jetons du Keystore ne sont de toute
     façon pas transférables ; la base locale ne doit pas fuiter non plus. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
